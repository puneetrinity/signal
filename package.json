{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/schema-control/schema-ready.mjs && next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:bootstrap-empty": "node scripts/bootstrap-empty-db.mjs",
    "db:check-drift": "node scripts/check-schema-drift.mjs",
    "check:no-db-push": "node scripts/check-no-db-push.mjs",
    "check:schema-control": "node scripts/schema-control/check-schema-control.mjs",
    "check:candidate-privacy": "node scripts/check-candidate-privacy-surfaces.mjs",
    "test:bootstrap": "node scripts/test-database-bootstrap.mjs",
    "test:schema-control": "node scripts/schema-control/test-schema-control-unit.mjs",
    "test:schema-control:pg": "node scripts/schema-control/test-schema-control-postgres.mjs",
    "test:candidate-privacy-surfaces": "node scripts/test-candidate-privacy-surfaces.mjs",
    "test:candidate-privacy": "vitest run src/lib/candidate-privacy/__tests__/candidate-privacy.test.ts src/lib/candidate-privacy/__tests__/surface-contract.test.ts",
    "test:candidate-privacy:pg": "RUN_SIGNAL_CANDIDATE_PRIVACY_POSTGRES=1 vitest run src/lib/candidate-privacy/__tests__/candidate-privacy-postgres.integration.test.ts --no-file-parallelism",
    "db:schema:adopt-existing": "node scripts/schema-control/adopt-existing.mjs",
    "db:schema:provision-runtime-role": "node scripts/schema-control/provision-runtime-role.mjs",
    "db:migrate:release": "node scripts/schema-control/migrate-release.mjs",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "worker:sourcing": "node scripts/schema-control/schema-ready.mjs && tsx src/lib/sourcing/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "SIGNAL_CANDIDATE_PRIVACY_TEST_ADAPTER=disposable_passthrough vitest run",
    "test:postgres": "SIGNAL_CANDIDATE_PRIVACY_TEST_ADAPTER=disposable_passthrough RUN_SIGNAL_POSTGRES_INTEGRATION=1 vitest run src/lib/sourcing/__tests__/candidate-index-repair-postgres.integration.test.ts src/lib/sourcing/__tests__/materialization-postgres.integration.test.ts src/lib/sourcing/__tests__/search-cache-index-repair-postgres.integration.test.ts --no-file-parallelism",
    "test:two-layer": "SIGNAL_CANDIDATE_PRIVACY_TEST_ADAPTER=disposable_passthrough vitest run src/lib/sourcing/__tests__/two-layer-pool.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.17",
    "@ai-sdk/groq": "^2.0.33",
    "@langchain/core": "^1.1.6",
    "@langchain/langgraph": "^1.0.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@prisma/client": "^6.5.0",
    "ai": "^5.0.60",
    "bullmq": "^5.66.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "jose": "^6.1.3",
    "next": "^15.5.9",
    "pino": "^10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^6.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
